# Copy to .env (or run ./scripts/setup-env.sh, which also generates secrets).
# Used by: `npm run dev` in server/ (host-run dev) and as overrides for docker compose.
# Never commit a real .env.

NODE_ENV=development
LOG_LEVEL=info
PORT=4000

# --- Datastores (host ports published by docker-compose.yml) ---
POSTGRES_PASSWORD=parley_dev_password
DATABASE_URL=postgres://parley:parley_dev_password@localhost:55432/parley
REDIS_URL=redis://localhost:56379

# --- Auth ---
# openssl rand -base64 48
JWT_ACCESS_SECRET=
OTP_HMAC_SECRET=
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
# mock = codes readable via GET /api/dev/otp (refused when NODE_ENV=production)
OTP_PROVIDER=mock
LOGIN_REQUIRE_OTP=true
# Allowed browser origins (CORS + WebSocket Origin check)
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# --- Object storage (MinIO / any S3) ---
MINIO_ROOT_USER=parley_minio
MINIO_ROOT_PASSWORD=parley_minio_dev_password
S3_ENDPOINT=http://localhost:59000
# Endpoint browsers use for presigned URLs
S3_PUBLIC_ENDPOINT=http://localhost:59000
S3_BUCKET=parley-media
S3_ACCESS_KEY=parley_minio
S3_SECRET_KEY=parley_minio_dev_password

# --- WebRTC ---
STUN_URLS=stun:localhost:3478
TURN_URLS=turn:localhost:3478?transport=udp,turn:localhost:3478?transport=tcp
# Shared with coturn (--static-auth-secret). Clients only ever get short-lived HMAC credentials.
TURN_SECRET=
TURN_CREDENTIAL_TTL_SECONDS=3600

# --- Web Push (generate with: cd server && npm run vapid) ---
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# --- Realtime tuning ---
HEARTBEAT_INTERVAL_MS=25000
PRESENCE_GRACE_MS=8000
CALL_RING_TIMEOUT_MS=45000
CALL_RECONNECT_GRACE_MS=30000
